* {
    /* `otf-font-awesome` is required to be installed for icons */
    font-family: AdwaitaMono; /*FontAwesme, Roboto, Helvetica, Arial, sans-serif, Rajdhani-Bold, Bitrimus;*/
    font-size: 12px;
}

window#waybar {
    background-color: rgba(43, 48, 59, 0.0);
    border-radius: 12px;
    border-top: 0px solid rgba(100, 114, 125, 0.5);
    border-bottom: 0px solid rgba(100, 114, 125, 0.5);
    color: #ffffff;
    transition-property: background-color;
    transition-duration: .5s;
}

button {
    /* Use box-shadow instead of border so the text isn't offset */
    box-shadow: inset 0 -3px transparent;
    /* Avoid rounded borders under each button name */
    border: none;
    border-radius: 4px;
}

/* https://github.com/Alexays/Waybar/wiki/FAQ#the-workspace-buttons-have-a-strange-hover-effect */
button:hover {
    background: inherit;
    box-shadow: inset 0 -3px #ffffff;
}

#bluetooth,
#clock,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#backlight-slider,
#network,
#pulseaudio,
#pulseaudio-slider,
#custom-cliamp,
#wireplumber,
#custom-media,
#tray,
#mode,
#idle_inhibitor,
#scratchpad,
#power-profiles-daemon,
#mpd {
    padding: 0px 15px;
    color: #ffffff;
    /*margin: 5px 0px 5px 0px;*/
}

.modules-left {
    margin-left: 10px;
}

.modules-right {
    margin-right: 10px;
}

@keyframes blink {
    to {
        background-color: #ffffff;
        color: #000000;
    }
}


/****************************/
/***********MIDDLE***********/
/****************************/

/*#workspaces {
    border-radius: 12px;
    background-color: rgba (32, 34, 49, 0.8);
}*/
#workspaces button {
    padding: 0 1px;
    color: #6b6d7c; /* Dim color for empty persistent workspaces */
    background: transparent;
    box-shadow: none;
    border: none;
}
#workspaces button.active {
    /*color: #d6b4b4;*/
    color: #709bbd;
    border-bottom: 0px solid #b4befe; /* Line under active workspace */
    background: transparent;
    box-shadow: none;
    border: none;
}
#workspaces button.occupied {
    color: #d1918f; /* Different color if the workspace has windows open */
}
#workspaces button.urgent {
    color: #11111b;
    background-color: #f38ba8;
}
#workspaces button:hover{
    background: rgba(0, 0, 0, 0.1);
}

#custom-cliamp {
    background-color: rgba (32, 34, 49, 0.8);
    color: #cdd6f4;
    border-radius: 12px;
    padding: 0 12px;
    font-weight: bold;
    transition: all 0.3s ease;
}
#custom-cliamp.hidden {
    padding: 0;
    margin: 0;
    border: 0px solid transparent;
    background-color: transparent;
}

/****************************/
/************LEFT************/
/****************************/

#cpu {
    background-color: rgba (32, 34, 49, 0.8);
    color: #709bbd;
    border: 0px solid rgba(112, 155, 189, 0.8);
    border-radius: 12px;
}
#cpu:hover {
    background-color: #6b6d7c;
    color: #ffffff;
}

#memory {
    background-color: rgba (32, 34, 49, 0.8);
    color: #709bbd;
    border: 0px solid rgba(112, 155, 189, 0.8);
    border-radius: 12px;
}
#memory:hover {
    background-color: #6b6d7c;
    color: #ffffff;
}

#network {
    background-color: rgba (32, 34, 49, 0.8);
    color: #709bbd;
    border: 0px solid rgba(112, 155, 189, 0.8);
    border-radius: 12px;
}
#network.disconnected {
    background-color: #dee0ef;
}
#network:hover {
    background-color: #6b6d7c;
    color: #ffffff;
}

#disk {
    background-color: #964B00;
}
#disk:hover {
    background-color: #6b6d7c;
    color: #ffffff;
}

#bluetooth {
    background-color: rgba (32, 34, 49, 0.8);
    color: #709bbd;
    border: 0px solid rgba(112, 155, 189, 0.8);
    border-radius: 12px;
}
#bluetooth:hover {
    background-color: #6b6d7c;
    color: #ffffff;
}

/****************************/
/***********RIGHT************/
/****************************/

#clock {
      background-color: transparent;
      font-size: 20px;
}

#battery {
    background-color: rgba (32, 34, 49, 0.8);
    color: #d1918f;
    border: 0px solid rgba(209, 145, 143, 0.8);
    border-radius: 12px;
}
#battery.charging, #battery.plugged {
    color: #ffffff;
    background-color: #6b6d7c;
}
/* Using steps() instead of linear as a timing function to limit cpu usage */
#battery.critical:not(.charging) {
    background-color: #f53c3c;
    color: #ffffff;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: steps(12);
    animation-iteration-count: infinite;
    animation-direction: alternate;
}
#battery:hover {
    background-color: #6b6d7c;
    color: #ffffff;
}

#backlight {
    background-color: rgba (32, 34, 49, 0.8);
    color: #d1918f;
    border: 0px solid rgba(209, 145, 143, 0.8);
    border-radius: 12px;
}
#backlight:hover {
    background-color: #6b6d7c;
    color: #ffffff;
}
#backlight-slider {
    padding: 0 12px;
    margin: 0 5px;
}
#backlight-slider trough {
    min-width: 80px;
    min-height: 4px;
    border-radius: 4px;
    background-color: rgba(209, 145, 143, 0.8);
}
#backlight-slider highlight {
    background-image: none;
    border-radius: 4px;
    background-color: #d6b4b4;
}
#backlight-slider slider {
    box-shadow: none;
    background-color: transparent;
}

#pulseaudio {
    background-color: rgba (32, 34, 49, 0.8);
    color: #d1918f;
    border: 0px solid rgba(209, 145, 143, 0.8);
    border-radius: 12px;
}
/* you can set a style on hover for any module like this */
#pulseaudio:hover {
    background-color: #6b6d7c;
    color: #ffffff;
}
#pulseaudio.muted {
    background-color: #90b1b1;
    color: #2a5c45;
}
#pulseaudio-slider {
    padding: 0 12px;
    margin: 0 5px;
}
#pulseaudio-slider trough {
    min-width: 80px;
    min-height: 4px;
    border-radius: 4px;
    background-color: rgba(209, 145, 143, 0.8);
}
#pulseaudio-slider highlight {
    background-image: none;
    border-radius: 4px;
    background-color: #d6b4b4;
}
#pulseaudio-slider slider {
    box-shadow: none;
    background-color: transparent;
}

